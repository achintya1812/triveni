{
  "name": "@triveni/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "seed:audio": "tsx --env-file=.env scripts/seed-audio.ts",
    "make:standins": "tsx --env-file=.env scripts/make-standins.ts",
    "warm:speech": "tsx scripts/warm-speech.ts",
    "review:content": "tsx scripts/review-content.ts",
    "slate:accuracy": "tsx --env-file=.env scripts/slate-accuracy.ts",
    "voice:accuracy": "tsx --env-file=.env scripts/voice-accuracy.ts",
    "telegram:webhook": "tsx --env-file=.env scripts/telegram-webhook.ts",
    "telegram:warm": "tsx --env-file=.env scripts/warm-telegram.ts",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.5",
    "@supabase/supabase-js": "^2.118.0",
    "@triveni/content": "workspace:*",
    "@triveni/core": "workspace:*",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
